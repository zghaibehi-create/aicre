{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicre:schemas:report-v2",
  "title": "AICRE 0.2 Inventory and Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aicre_version",
    "profile",
    "generated_at",
    "findings",
    "readiness"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "aicre_version": {"const": "0.2.0"},
    "profile": {"const": "standard"},
    "generated_at": {"type": "string", "format": "date-time"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_readiness",
        "software_readiness",
        "compatibility_readiness",
        "privacy_readiness",
        "security_readiness"
      ],
      "properties": {
        "resource_readiness": {"$ref": "#/$defs/readiness_dimension"},
        "software_readiness": {"$ref": "#/$defs/readiness_dimension"},
        "compatibility_readiness": {"$ref": "#/$defs/readiness_dimension"},
        "privacy_readiness": {"$ref": "#/$defs/readiness_dimension"},
        "security_readiness": {"$ref": "#/$defs/readiness_dimension"}
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "status",
        "value",
        "unit",
        "source",
        "confidence",
        "collected_at",
        "limitations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "category": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "detected",
            "not_detected",
            "unsupported",
            "permission_denied",
            "error",
            "not_checked"
          ]
        },
        "value": {"type": ["object", "array", "string", "number", "integer", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "collected_at": {"type": "string", "format": "date-time"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "readiness_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "explanation", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "warning", "fail", "unknown"]},
        "explanation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
